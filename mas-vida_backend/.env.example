# Copia este archivo como .env y llena los valores. El .env NUNCA va al repo.
# Las líneas que empiezan con # son explicaciones.

# --- Modo -------------------------------------------------------------------------
# En tu computadora: DEBUG=true. En el servidor: no la pongas (o DEBUG=false).
DEBUG=true

# --- Secretos (OBLIGATORIOS en el servidor) -----------------------------------------
# Una clave nueva y distinta para cada servidor. Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# La que estaba en settings.py quedó en el historial de git: no se usa en ningún lado.
SECRET_KEY=

# --- Dirección del backend (OBLIGATORIA en el servidor) -----------------------------
# Separadas por coma. En tu computadora se pueden dejar vacías (acepta cualquiera).
# ALLOWED_HOSTS=api.masvida.com
# CSRF_TRUSTED_ORIGINS=https://api.masvida.com
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Cuántos proxies hay delante del backend. Detrás de Caddy o del balanceador de AWS: 1.
# En tu computadora: 0.
NUM_PROXIES_CONFIABLES=0

# --- Base de datos ------------------------------------------------------------------
# La base de Docker en tu computadora (servicio "db" de compose.yaml).
POSTGRES_DB=mas_vida
POSTGRES_USER=mas_vida_user
POSTGRES_PASSWORD=change_me

DB_ENGINE=postgresql
DB_NAME=mas_vida
DB_USER=mas_vida_user
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432
# Con RDS en el servidor: DB_HOST es el "endpoint" de RDS, DB_SSLMODE=require y
# DB_CONN_MAX_AGE=60 (reutiliza la conexión 60 segundos).
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# --- Reglas que se pueden ajustar sin tocar código (opcionales) -----------------------
# Bloquear el sync a quien no tiene el consentimiento vigente. Swift ya lo maneja (A38).
# CONSENTIMIENTO_OBLIGATORIO=true
# Días sin uso antes de que venza un token (por defecto 30).
# DIAS_DE_VIDA_DEL_TOKEN=30
# Límites de intentos (máximo/segundos). Útil si muchas personas entran desde el mismo Wi-Fi.
# LIMITES_DE_INTENTOS=login_ip=300/60,registro_ip=300/3600
